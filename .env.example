# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client-side configurations
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=


# FCM VAPID keys (VAPID Key Pair)
# Public VAPID Key is required on the client side for getToken()
VITE_FIREBASE_VAPID_KEY=

# ---- AI Coach (Android) ----
# Production URL of the site that serves /api/coach/* (e.g. your Vercel production domain, no trailing slash).
# Only used inside the Android app; the web build calls /api/coach on its own domain.
VITE_COACH_API_BASE_URL=
